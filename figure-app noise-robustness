# ============================================================
# 2. MATHIEU / FLOQUET UTILITIES
# ============================================================

PERIOD = math.pi


def fundamental_rhs(t: float, y: np.ndarray, a: float, q: float):
    """
    Integrate two fundamental solutions simultaneously.

    State ordering:
        y = [phi11, phi21, phi12, phi22]

    so that
        Phi = [[phi11, phi12],
               [phi21, phi22]]
    """
    phi11, phi21, phi12, phi22 = y
    k = a - 2.0 * q * math.cos(2.0 * t)

    return np.array([
        phi21,
        -k * phi11,
        phi22,
        -k * phi12,
    ])


def fundamental_matrix(a: float, q: float, t_end: float) -> np.ndarray:
    """Return Phi(t_end) with Phi(0)=I."""
    if abs(t_end) < 1e-15:
        return np.eye(2)

    sol = solve_ivp(
        fun=lambda t, y: fundamental_rhs(t, y, a, q),
        t_span=(0.0, float(t_end)),
        y0=np.array([1.0, 0.0, 0.0, 1.0]),
        method=METHOD,
        rtol=RTOL,
        atol=ATOL,
    )

    if not sol.success:
        raise RuntimeError(
            f"Fundamental-matrix integration failed at (a,q)=({a},{q}): "
            f"{sol.message}"
        )

    p11, p21, p12, p22 = sol.y[:, -1]
    return np.array([[p11, p12], [p21, p22]], dtype=float)


def clean_point_quantities(a: float, q: float):
    """
    Compute:
      delta_v_clean = v(tau) - v(0)
      V_L_clean
      mu_VL_clean
      mu_F           = maximal Floquet growth rate

    Uses periodic propagation Phi(tau)=Phi(r) M^n.
    """
    M = fundamental_matrix(a, q, PERIOD)

    multipliers = np.linalg.eigvals(M)
    rho = float(np.max(np.abs(multipliers)))
    mu_F_raw = math.log(max(rho, FLOAT_TINY)) / PERIOD

    # For a Hamiltonian Mathieu system stable Floquet multipliers lie on
    # the unit circle; tiny +/- values are numerical roundoff.
    mu_F = 0.0 if abs(mu_F_raw) <= FLOQUET_ZERO_TOL else max(0.0, mu_F_raw)

    n_periods = int(math.floor(TAU / PERIOD))
    remainder = TAU - n_periods * PERIOD

    R = fundamental_matrix(a, q, remainder)
    M_n = np.linalg.matrix_power(M, n_periods)

    z0 = np.array([X0, V0], dtype=float)
    z_tau = R @ M_n @ z0

    v_tau = float(z_tau[1])
    delta_v = v_tau - V0

    V_L = abs(delta_v) / TAU
    mu_VL = math.log(max(V_L, VL_LOG_FLOOR)) / TAU

    return delta_v, V_L, mu_VL, mu_F


def _grid_worker(args):
    """Top-level worker for Windows-compatible multiprocessing."""
    i_q, i_a, a, q = args
    delta_v, V_L, mu_VL, mu_F = clean_point_quantities(a, q)
    return i_q, i_a, delta_v, V_L, mu_VL, mu_F


# ============================================================
# 3. CLEAN PARAMETER-SPACE MAP + CACHE
# ============================================================

def compute_clean_maps(a_values: np.ndarray, q_values: np.ndarray):
    """
    Compute deterministic endpoint and Floquet maps.

    Array convention:
        rows    -> q
        columns -> a
    """
    shape = (len(q_values), len(a_values))

    delta_v_map = np.empty(shape, dtype=float)
    VL_map = np.empty(shape, dtype=float)
    muVL_map = np.empty(shape, dtype=float)
    muF_map = np.empty(shape, dtype=float)

    tasks = [
        (iq, ia, float(a), float(q))
        for iq, q in enumerate(q_values)
        for ia, a in enumerate(a_values)
    ]

    print(f"Computing clean maps on {shape[1]} x {shape[0]} grid ...")
    print(f"Parallel workers: {N_JOBS}")

    if N_JOBS == 1:
        iterator = map(_grid_worker, tasks)
        for k, result in enumerate(iterator, start=1):
            iq, ia, delta_v, VL, muVL, muF = result
            delta_v_map[iq, ia] = delta_v
            VL_map[iq, ia] = VL
            muVL_map[iq, ia] = muVL
            muF_map[iq, ia] = muF
            if k % 1000 == 0 or k == len(tasks):
                print(f"  completed {k}/{len(tasks)}")
    else:
        with ProcessPoolExecutor(max_workers=N_JOBS) as ex:
            iterator = ex.map(_grid_worker, tasks, chunksize=20)
            for k, result in enumerate(iterator, start=1):
                iq, ia, delta_v, VL, muVL, muF = result
                delta_v_map[iq, ia] = delta_v
                VL_map[iq, ia] = VL
                muVL_map[iq, ia] = muVL
                muF_map[iq, ia] = muF
                if k % 1000 == 0 or k == len(tasks):
                    print(f"  completed {k}/{len(tasks)}")

    return delta_v_map, VL_map, muVL_map, muF_map


def cache_filename():
    tau_tag = str(TAU).replace(".", "p")
    return OUTDIR / f"clean_map_cache_na{N_A}_nq{N_Q}_tau{tau_tag}.npz"


def load_or_compute_clean_maps(a_values, q_values):
    cache = cache_filename()

    if cache.exists():
        data = np.load(cache)

        same_config = (
            np.array_equal(data["a_values"], a_values)
            and np.array_equal(data["q_values"], q_values)
            and float(data["tau"]) == TAU
            and float(data["x0"]) == X0
            and float(data["v0"]) == V0
        )

        if same_config:
            print(f"Loading cached clean maps: {cache}")
            return (
                data["delta_v_map"],
                data["VL_map"],
                data["muVL_map"],
                data["muF_map"],
            )

        print("Cache exists but configuration changed; recomputing.")

    maps = compute_clean_maps(a_values, q_values)
    delta_v_map, VL_map, muVL_map, muF_map = maps

    np.savez_compressed(
        cache,
        a_values=a_values,
        q_values=q_values,
        tau=TAU,
        x0=X0,
        v0=V0,
        delta_v_map=delta_v_map,
        VL_map=VL_map,
        muVL_map=muVL_map,
        muF_map=muF_map,
    )
    print(f"Saved clean-map cache: {cache}")

    return maps


# ============================================================
# 4. OBSERVATIONAL NOISE
# ============================================================

def sigma_from_percent(noise_percent: float) -> float:
    return (noise_percent / 100.0) * V_NOISE_REF


def noisy_mu_samples(delta_v: float, noise_percent: float, n_mc: int, rng):
    """
    Generate Monte-Carlo mu_VL samples.

    Explicit measurement model:
        eta0   ~ N(0,sigma^2)
        etaTau ~ N(0,sigma^2)
    independently.
    """
    if noise_percent == 0.0:
        VL = abs(delta_v) / TAU
        mu = math.log(max(VL, VL_LOG_FLOOR)) / TAU
        return np.full(n_mc, mu, dtype=float)

    sigma = sigma_from_percent(noise_percent)

    eta0 = rng.normal(loc=0.0, scale=sigma, size=n_mc)
    etaTau = rng.normal(loc=0.0, scale=sigma, size=n_mc)

    noisy_delta_v = delta_v + (etaTau - eta0)
    noisy_VL = np.abs(noisy_delta_v) / TAU
    noisy_mu = np.log(np.maximum(noisy_VL, VL_LOG_FLOOR)) / TAU

    return noisy_mu


def median_noisy_mu_map(
    delta_v_map: np.ndarray,
    noise_percent: float,
    n_mc: int,
    seed: int,
):
    """
    Return pixelwise Monte-Carlo median of mu_VL over the parameter grid.

    For efficiency:
        etaTau - eta0 ~ N(0, 2 sigma^2)
    is sampled directly. This is exactly equivalent to sampling the two
    endpoint errors independently and subtracting them.
    """
    if noise_percent == 0.0:
        VL = np.abs(delta_v_map) / TAU
        return np.log(np.maximum(VL, VL_LOG_FLOOR)) / TAU

    sigma = sigma_from_percent(noise_percent)
    rng = np.random.default_rng(seed)

    flat = delta_v_map.ravel()
    median_flat = np.empty_like(flat)

    for start in range(0, len(flat), MAP_BATCH_SIZE):
        stop = min(start + MAP_BATCH_SIZE, len(flat))
        d = flat[start:stop]

        # Common-random-number design within a noise level.
        # Shape = (Monte Carlo realization, parameter point in batch)
        z = rng.standard_normal(size=(n_mc, stop - start))
        delta_eta = math.sqrt(2.0) * sigma * z

        noisy_delta = d[None, :] + delta_eta
        noisy_VL = np.abs(noisy_delta) / TAU
        noisy_mu = np.log(np.maximum(noisy_VL, VL_LOG_FLOOR)) / TAU

        median_flat[start:stop] = np.median(noisy_mu, axis=0)

    return median_flat.reshape(delta_v_map.shape)


