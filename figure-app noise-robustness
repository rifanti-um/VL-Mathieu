def print_noise_definition():
    """Print the exact percentage convention used in the experiment."""
    print("\nExplicit observational-noise convention:")
    print("  alpha (%) = reported Gaussian noise level")
    print("  sigma = (alpha / 100) * v_ref")
    print(f"  v_ref = {V_NOISE_REF:g} (fixed over the entire parameter space)")
    for alpha in (1.0, 5.0, 10.0):
        print(
            f"  {alpha:g}% noise -> sigma = "
            f"{sigma_from_percent(alpha):.6g}"
        )
    print(
        "  eta_0, eta_tau are independent N(0, sigma^2); "
        "therefore eta_tau-eta_0 has std sqrt(2)*sigma."
    )


def save_experiment_metadata():
    """Save the precise noise convention and fixed analysis choices."""
    path = OUTDIR / "noise_experiment_metadata.txt"

    with open(path, "w", encoding="utf-8") as f:
        f.write("Gaussian observational-noise experiment for V_L\n")
        f.write("=" * 56 + "\n\n")
        f.write("Endpoint measurement model:\n")
        f.write("  v_tilde(0)   = v(0)   + eta_0\n")
        f.write("  v_tilde(tau) = v(tau) + eta_tau\n")
        f.write("  eta_0, eta_tau ~ N(0, sigma^2), independently\n\n")
        f.write("Noise percentage convention:\n")
        f.write("  sigma = (alpha/100) * v_ref\n")
        f.write(f"  v_ref = {V_NOISE_REF:g}, fixed over parameter space\n")
        for alpha in (1.0, 5.0, 10.0):
            f.write(
                f"  alpha={alpha:g}% -> "
                f"sigma={sigma_from_percent(alpha):.8g}\n"
            )
        f.write("\n")
        f.write("Representative points:\n")
        for label, (a, q) in REPRESENTATIVE_POINTS.items():
            f.write(f"  {label}: (a,q)=({a:g},{q:g})\n")
        f.write("\n")
        f.write(f"tau = {TAU:g}\n")
        f.write(f"N_MC_REP = {N_MC_REP}\n")
        f.write(f"N_MC_MAP = {N_MC_MAP}\n")
        f.write(
            f"Fixed V_L classification threshold: "
            f"mu_VL > {MU_CLASS_THRESHOLD:g}\n"
        )
        f.write(
            f"Floquet ground truth threshold: "
            f"mu_F > {FLOQUET_ZERO_TOL:g}\n"
        )
        f.write(
            "P_flip = fraction of grid points whose median-noisy "
            "classification differs from the clean V_L classification.\n"
        )
        f.write(
            "Q95_abs_delta_mu = 95th percentile over the parameter grid of "
            "|median(mu_VL noisy)-mu_VL clean|.\n"
        )

    print(f"Saved experiment metadata: {path}")


def print_noise_floor_guideline():
    """
    For scalar velocity (m=1), delta_eta has RMS sqrt(2)*sigma.
    Hence a characteristic endpoint noise floor is approximately

        V_L,noise ~ sqrt(2)*sigma / tau.

    This is printed only as an interpretation aid.
    """
    print("\nCharacteristic endpoint-noise floor (scalar velocity):")
    print(
        f"{'Noise':>8s} {'sigma':>12s} "
        f"{'sqrt(2)sigma/tau':>20s}"
    )
    print("-" * 44)

    for noise in NOISE_LEVELS_PERCENT:
        sigma = sigma_from_percent(float(noise))
        floor = math.sqrt(2.0) * sigma / TAU
        print(f"{noise:7.1f}% {sigma:12.4e} {floor:20.4e}")


