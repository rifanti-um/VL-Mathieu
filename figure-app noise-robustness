\label{tab:noise_sensitivity}
\begin{tabular}{ccccccc}
\hline
Noise & Agreement & FPR & FNR & $P_{\rm flip}$ & MAE & $Q_{95}(|\Delta\mu|)$ \\
\hline
"""
        )

        for row in rows:
            f.write(
                f"{row['Noise (%)']:g}\\% & "
                f"{row['Agreement']:.4f} & "
                f"{row['FPR']:.4f} & "
                f"{row['FNR']:.4f} & "
                f"{row['P_flip']:.4f} & "
                f"{row['MAE_muVL']:.4e} & "
                f"{row['Q95_abs_delta_mu']:.4e} "
                + r"\\"
                + "\n"
            )

        f.write(
r"""\hline
\end{tabular}
\end{table}
"""
        )

    print("\nTable A2")
    print("-" * 112)
    print(
        f"{'Noise':>8s} {'Agreement':>12s} {'FPR':>10s} "
        f"{'FNR':>10s} {'P_flip':>10s} "
        f"{'MAE(muVL)':>14s} {'Q95(|dmu|)':>14s}"
    )
    print("-" * 112)

    for row in rows:
        print(
            f"{row['Noise (%)']:7.1f}% "
            f"{row['Agreement']:12.4f} "
            f"{row['FPR']:10.4f} "
            f"{row['FNR']:10.4f} "
            f"{row['P_flip']:10.4f} "
            f"{row['MAE_muVL']:14.4e} "
            f"{row['Q95_abs_delta_mu']:14.4e}"
        )

    print("-" * 112)
    print(f"Fixed V_L classification threshold: mu_VL > {MU_CLASS_THRESHOLD:g}")
    print(
        "Floquet ground truth: unstable if "
        f"mu_F > {FLOQUET_ZERO_TOL:g}"
    )
    print(f"CSV:   {csv_path}")
    print(f"LaTeX: {tex_path}")


