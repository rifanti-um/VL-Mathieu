        (
            f"(c) {A4_NOISE_LEVELS_PERCENT[1]:g}% Gaussian noise",
            mu_5,
        ),
    ]

    image_handles = []

    for ax, (title, data) in zip(
        [ax_a, ax_b, ax_c],
        panel_data,
    ):
        im = ax.imshow(
            data,
            origin="lower",
            extent=extent,
            aspect="auto",
            cmap=CMAP_RATE,
            vmin=vmin,
            vmax=vmax,
            interpolation="nearest",
        )
        image_handles.append(im)
        ax.set_title(title)
        ax.set_xlabel("$a$")
        ax.set_ylabel("$q$")

    # One shared colorbar for panels (a)-(c), in its own dedicated axis.
    cbar_rate = fig.colorbar(
        image_handles[0],
        cax=cax_rate,
    )
    cbar_rate.set_label(r"$\mu_{V_L}(\tau)$")
    cax_rate.set_title("(a)-(c)", fontsize=9, pad=7)

    # Panel (d): absolute difference at the larger displayed noise level.
    im_diff = ax_d.imshow(
        delta_mu,
        origin="lower",
        extent=extent,
        aspect="auto",
        cmap=CMAP_DIFF,
        interpolation="nearest",
        vmin=0.0,
    )
    ax_d.set_title(
        f"(d) $|\\mathrm{{median}}(\\widetilde{{\\mu}}_{{V_L}})"
        f"-\\mu_{{V_L}}^{{\\rm clean}}|$ at "
        f"{A4_NOISE_LEVELS_PERCENT[1]:g}%"
    )
    ax_d.set_xlabel("$a$")
    ax_d.set_ylabel("$q$")

    # Overlay the Floquet stability boundary on the difference map.
    # We contour the binary stable/unstable ground-truth field at 0.5.
    if SHOW_FLOQUET_BOUNDARY:
        floquet_binary = (muF_map > FLOQUET_ZERO_TOL).astype(float)
        boundary = ax_d.contour(
            a_values,
            q_values,
            floquet_binary,
            levels=[0.5],
            colors="white",
            linewidths=BOUNDARY_LINEWIDTH,
        )

    # Dedicated colorbar for panel (d), so it cannot overlap the rate bar.
    cbar_diff = fig.colorbar(
        im_diff,
        cax=cax_diff,
    )
    cbar_diff.set_label(r"$\Delta\mu_{\rm noise}$")
    cax_diff.set_title("(d)", fontsize=9, pad=7)

    fig.savefig(
        OUTDIR / "Figure_A4_noise_parameter_space.pdf",
        bbox_inches="tight",
    )
    fig.savefig(
        OUTDIR / "Figure_A4_noise_parameter_space.png",
        dpi=DPI,
        bbox_inches="tight",
    )
    plt.close(fig)

    print("Saved Figure A4.")

    # --------------------------------------------------------
    # Table A2
    # --------------------------------------------------------
    rows = []

    for noise in NOISE_LEVELS_PERCENT:
        noise = float(noise)
        mu_est = noisy_maps[noise]

        metrics = classification_metrics(mu_est, muF_map)

        # Noise sensitivity of finite-time V_L estimate:
        # compare the median noisy field against the deterministic clean field.
        abs_delta_mu = np.abs(mu_est - muVL_clean_map)
        mae = float(np.mean(abs_delta_mu))
        q95_abs_delta_mu = float(np.percentile(abs_delta_mu, 95.0))

        # P_flip: fraction of parameter-grid points whose CLASSIFICATION
        # changes relative to the clean finite-time V_L classification.
        # The same fixed threshold is used for both clean and noisy fields.
        clean_pred = muVL_clean_map > MU_CLASS_THRESHOLD
        noisy_pred = mu_est > MU_CLASS_THRESHOLD
        p_flip = float(np.mean(noisy_pred != clean_pred))

        row = {
            "Noise (%)": noise,
            "Agreement": metrics["Agreement"],
            "P_conv": metrics["P_conv"],
            "FPR": metrics["FPR"],
            "FNR": metrics["FNR"],
            "P_flip": p_flip,
            "MAE_muVL": mae,
            "Q95_abs_delta_mu": q95_abs_delta_mu,
            "TP": metrics["TP"],
            "TN": metrics["TN"],
            "FP": metrics["FP"],
            "FN": metrics["FN"],
        }
        rows.append(row)

    # CSV contains Agreement and P_conv alias, plus confusion counts.
    csv_path = OUTDIR / "Table_A2_noise_sensitivity.csv"
    fieldnames = [
        "Noise (%)", "Agreement", "P_conv", "FPR", "FNR",
        "P_flip", "MAE_muVL", "Q95_abs_delta_mu",
        "TP", "TN", "FP", "FN",
    ]

    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    # LaTeX version uses exactly the compact columns requested.
    tex_path = OUTDIR / "Table_A2_noise_sensitivity.tex"
    with open(tex_path, "w", encoding="utf-8") as f:
        f.write(
r"""\begin{table}[t]
