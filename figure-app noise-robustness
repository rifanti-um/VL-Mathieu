def make_figure_A3():
    rng = np.random.default_rng(RANDOM_SEED)

    noise_levels = NOISE_LEVELS_PERCENT.astype(float)
    n_panels = len(REPRESENTATIVE_POINTS)

    fig, axes = plt.subplots(
        1, n_panels,
        figsize=(5.0 * n_panels, 4.2),
        constrained_layout=True,
    )
    if n_panels == 1:
        axes = [axes]

    rep_rows = []

    for ax, (label, (a, q)) in zip(axes, REPRESENTATIVE_POINTS.items()):
        delta_v, VL_clean, mu_clean, mu_F = clean_point_quantities(a, q)

        medians = []
        p05 = []
        p95 = []

        for noise in noise_levels:
            samples = noisy_mu_samples(
                delta_v=delta_v,
                noise_percent=float(noise),
                n_mc=N_MC_REP,
                rng=rng,
            )

            med = float(np.median(samples))
            lo = float(np.percentile(samples, 5.0))
            hi = float(np.percentile(samples, 95.0))

            medians.append(med)
            p05.append(lo)
            p95.append(hi)

            rep_rows.append({
                "regime": label,
                "a": a,
                "q": q,
                "noise_percent": noise,
                "sigma": sigma_from_percent(float(noise)),
                "mu_VL_clean": mu_clean,
                "mu_VL_median": med,
                "mu_VL_p05": lo,
                "mu_VL_p95": hi,
                "mu_F": mu_F,
            })

        medians = np.asarray(medians)
        p05 = np.asarray(p05)
        p95 = np.asarray(p95)

        # Monte-Carlo interval and median
        ax.fill_between(
            noise_levels, p05, p95,
            alpha=0.22,
            label="5–95% Monte Carlo interval",
        )
        ax.plot(
            noise_levels, medians,
            marker="o",
            linewidth=1.8,
            label="Median noisy $\\mu_{V_L}$",
        )

        # Clean finite-time mu_VL as a horizontal reference
        ax.axhline(
            mu_clean,
            linestyle="--",
            linewidth=1.5,
            label="Clean $\\mu_{V_L}$",
        )

        # True Floquet growth rate
        ax.axhline(
            mu_F,
            linestyle=":",
            linewidth=1.8,
            label="Floquet $\\mu_F$",
        )

        ax.set_title(
            f"{label}\n$(a,q)=({a:g},{q:g})$"
        )
        ax.set_xlabel(r"Gaussian noise level $\alpha$ (%)")
        ax.set_ylabel(r"$\mu_{V_L}(\tau)$")
        ax.grid(alpha=0.25)

        # Keep zero visible whenever it is reasonably close to the data.
        ymin = min(np.min(p05), mu_clean, mu_F)
        ymax = max(np.max(p95), mu_clean, mu_F)
        span = max(ymax - ymin, 1e-4)
        if ymin > 0 and ymin < 0.25 * span:
            ymin = 0.0
        ax.set_ylim(ymin - 0.10 * span, ymax + 0.10 * span)

        ax.legend(loc="best")

        print(
            f"{label:14s} (a,q)=({a:g},{q:g}) | "
            f"mu_clean={mu_clean:.6e}, mu_F={mu_F:.6e}, "
            f"|delta_v|={abs(delta_v):.6e}"
        )

    fig.savefig(OUTDIR / "Figure_A3_noise_representative_points.pdf",
                bbox_inches="tight")
    fig.savefig(OUTDIR / "Figure_A3_noise_representative_points.png",
                dpi=DPI, bbox_inches="tight")
    plt.close(fig)

    # Export underlying representative-point statistics
    csv_path = OUTDIR / "representative_noise_statistics.csv"
    fieldnames = [
        "regime", "a", "q", "noise_percent", "sigma",
        "mu_VL_clean", "mu_VL_median",
        "mu_VL_p05", "mu_VL_p95", "mu_F",
    ]
    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rep_rows)

    print("Saved Figure A3 and representative-point CSV.")


# ============================================================
# 6. CLASSIFICATION METRICS FOR TABLE A2
# ============================================================

def safe_rate(num: int, den: int) -> float:
    return float(num / den) if den > 0 else float("nan")


def classification_metrics(mu_est: np.ndarray, muF_map: np.ndarray):
    """
    Ground truth:
        unstable if mu_F > FLOQUET_ZERO_TOL

    V_L prediction:
        unstable if mu_est > MU_CLASS_THRESHOLD

    MU_CLASS_THRESHOLD is NEVER changed with noise level.
    """
    true_unstable = muF_map > FLOQUET_ZERO_TOL
    pred_unstable = mu_est > MU_CLASS_THRESHOLD

    TP = int(np.sum(pred_unstable & true_unstable))
    TN = int(np.sum(~pred_unstable & ~true_unstable))
    FP = int(np.sum(pred_unstable & ~true_unstable))
    FN = int(np.sum(~pred_unstable & true_unstable))

    N = TP + TN + FP + FN

    agreement = safe_rate(TP + TN, N)
    fpr = safe_rate(FP, FP + TN)
    fnr = safe_rate(FN, FN + TP)

    return {
        "TP": TP,
        "TN": TN,
        "FP": FP,
        "FN": FN,
        "Agreement": agreement,
        # Alias retained in case Appendix A uses P_conv notation.
        "P_conv": agreement,
        "FPR": fpr,
        "FNR": fnr,
    }


