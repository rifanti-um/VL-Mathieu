def make_figure_A4_and_table_A2(
    a_values,
    q_values,
    delta_v_map,
    muVL_clean_map,
    muF_map,
):
    # Compute all noisy median maps required for Table A2 only once.
    noisy_maps = {0.0: muVL_clean_map.copy()}

    for j, noise in enumerate(NOISE_LEVELS_PERCENT):
        noise = float(noise)
        if noise == 0.0:
            continue

        print(f"Monte-Carlo median map: noise={noise:g}%")
        noisy_maps[noise] = median_noisy_mu_map(
            delta_v_map=delta_v_map,
            noise_percent=noise,
            n_mc=N_MC_MAP,
            seed=RANDOM_SEED + 1000 + j,
        )

    # --------------------------------------------------------
    # Figure A4
    # --------------------------------------------------------
    mu_1 = noisy_maps[float(A4_NOISE_LEVELS_PERCENT[0])]
    mu_5 = noisy_maps[float(A4_NOISE_LEVELS_PERCENT[1])]

    # Requested absolute difference map:
    delta_mu = np.abs(mu_5 - muVL_clean_map)

    # Shared scale for panels (a)-(c) is essential for visual comparison.
    rate_stack = np.concatenate([
        muVL_clean_map.ravel(),
        mu_1.ravel(),
        mu_5.ravel(),
    ])

    finite_rate = rate_stack[np.isfinite(rate_stack)]
    # Robust display limits avoid a few extreme logarithmic cancellations
    # dominating the color scale.
    vmin = float(np.percentile(finite_rate, 1.0))
    vmax = float(np.percentile(finite_rate, 99.0))

    extent = [
        float(a_values[0]), float(a_values[-1]),
        float(q_values[0]), float(q_values[-1]),
    ]

    # --------------------------------------------------------
    # Publication-safe layout:
    #   columns 1-2 : data panels
