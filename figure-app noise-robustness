    # --------------------------------------------------------
    fig = plt.figure(
        figsize=(12.2, 9.0),
        constrained_layout=True,
    )
    gs = fig.add_gridspec(
        nrows=2,
        ncols=3,
        width_ratios=[1.0, 1.0, 0.055],
        height_ratios=[1.0, 1.0],
