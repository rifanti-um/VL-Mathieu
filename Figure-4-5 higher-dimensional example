# ============================================================
# 9. Final interpretation
# ============================================================

print("\n" + "=" * 74)
print("INTERPRETATION FOR THE REVISED MANUSCRIPT")
print("=" * 74)

print(
    "\nFOUR-DIMENSIONAL SPECTRUM:\n"
    "  The system has two positive Floquet growth rates, mu_1 and mu_2,\n"
    "  together with two negative partners."
)

print(
    "\nGENERIC TRAJECTORY:\n"
    "  Both mu_VL^glob and mu_A_N approach mu_1. The second positive\n"
    "  rate mu_2 remains in the spectrum but becomes asymptotically\n"
    "  subdominant because mu_1 > mu_2."
)

print(
    "\nMODE-SELECTIVE TRAJECTORY:\n"
    "  For an initial condition aligned with the second unstable Floquet\n"
    "  mode, both mu_VL^glob and mu_A_N approach mu_2."
)

print(
    "\nSPECTRAL LIMITATION:\n"
    "  A single scalar/global V_L does not reconstruct the complete\n"
