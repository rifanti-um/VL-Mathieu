    # Robust common limits prevent isolated endpoint-cancellation spikes
    # from determining the entire scale.
    vmin = np.percentile(finite_growth, 1.0)
    vmax = np.percentile(finite_growth, 99.0)

    diff_finite = diff[np.isfinite(diff)]
    diff_vmax = np.percentile(diff_finite, 99.0)

    A, Q = np.meshgrid(a_values, q_values)

    # Do not use constrained_layout here because the two colorbars have
    # dedicated non-overlapping axes.
    fig, axes = plt.subplots(
        2, 2,
        figsize=(11.0, 8.4)
    )

    fig.subplots_adjust(
        left=0.075,
        right=0.875,
        bottom=0.08,
        top=0.95,
        wspace=0.20,
        hspace=0.23
    )

    panels = [
        (axes[0, 0], map80,  r"(a) $\tau=80$"),
        (axes[0, 1], map120, r"(b) $\tau=120$"),
        (axes[1, 0], map160, r"(c) $\tau=160$"),
    ]

    growth_mappable = None

    for ax, arr, title in panels:
        growth_mappable = ax.pcolormesh(
            A,
            Q,
            arr,
            shading="auto",
            cmap=CMAP_GROWTH,
            vmin=vmin,
            vmax=vmax
        )

        add_floquet_boundary(
            ax,
            A,
            Q,
            mu_f_map,
            color="k"
        )

        ax.set_title(title)
        ax.set_xlabel(r"$a$")
        ax.set_ylabel(r"$q$")

    # Panel (d)
    dmap = axes[1, 1].pcolormesh(
        A,
        Q,
        diff,
        shading="auto",
        cmap=CMAP_DIFFERENCE,
        vmin=0.0,
        vmax=diff_vmax
    )

    add_floquet_boundary(
        axes[1, 1],
        A,
        Q,
        mu_f_map,
        color="w"
    )

    axes[1, 1].set_title(
        r"(d) $|\mu_{V_L}(160)-\mu_{V_L}(120)|$"
    )
    axes[1, 1].set_xlabel(r"$a$")
    axes[1, 1].set_ylabel(r"$q$")

    # --------------------------------------------------------
    # Separate, non-overlapping colorbar axes
    # --------------------------------------------------------
    cax_growth = fig.add_axes([
        0.900, 0.555, 0.018, 0.345
    ])

    cbar_growth = fig.colorbar(
        growth_mappable,
        cax=cax_growth
    )
    cbar_growth.set_label(
        r"$\mu_{V_L}(a,q;\tau)$"
    )

    cax_diff = fig.add_axes([
        0.900, 0.115, 0.018, 0.345
    ])

    cbar_diff = fig.colorbar(
        dmap,
        cax=cax_diff
    )
    cbar_diff.set_label(
        r"$|\mu_{V_L}(160)-\mu_{V_L}(120)|$"
    )

    fig.savefig(
        "Figure_A2_horizon_sensitivity.png",
        dpi=DPI,
        bbox_inches="tight"
    )
    fig.savefig(
        "Figure_A2_horizon_sensitivity.pdf",
        bbox_inches="tight"
    )

    plt.close(fig)


# ============================================================
# 6. TABLE A1: P_rate, P_class, FPR, FNR
# ============================================================

def rate_convergence_mask(mu1, mu2):
    """
    Numerical rate-convergence criterion.

    |mu2-mu1|
    <= EPS_ABS + EPS_REL*max(|mu1|,|mu2|)
    """
    diff = np.abs(mu2 - mu1)
    scale = np.maximum(
        np.abs(mu1),
        np.abs(mu2)
    )

    return diff <= (
        EPS_ABS + EPS_REL*scale
    )


def finite_time_classification(mu_vl):
    """
    Binary V_L classification.

    True  -> finite-time growing/unstable classification
    False -> non-growing/stable classification
    """
    return mu_vl > MU_CLASS_TOL


def classification_stability_mask(mu1, mu2):
    """
    Classification stability between two successive horizons.

    A grid point is classification-stable if its binary classification
    does not change when tau is increased.
    """
    class1 = finite_time_classification(mu1)
    class2 = finite_time_classification(mu2)

    return class1 == class2


def classification_metrics(mu_vl, rho_map):
    """
    Compare the V_L finite-time classification with Floquet ground truth.

    Floquet:
        unstable iff rho_max > 1 + RHO_TOL

    V_L:
        unstable iff mu_VL > MU_CLASS_TOL

    Returns
    -------
    fpr : false-positive rate
    fnr : false-negative rate
    accuracy : overall classification agreement
    """
    truth_unstable = rho_map > (1.0 + RHO_TOL)
    truth_stable = ~truth_unstable

    pred_unstable = finite_time_classification(mu_vl)
    pred_stable = ~pred_unstable

    FP = np.count_nonzero(
        pred_unstable & truth_stable
    )
    FN = np.count_nonzero(
        pred_stable & truth_unstable
    )

    N_stable = np.count_nonzero(truth_stable)
    N_unstable = np.count_nonzero(truth_unstable)

    fpr = (
        FP / N_stable
        if N_stable > 0
        else np.nan
    )

    fnr = (
        FN / N_unstable
        if N_unstable > 0
        else np.nan
    )

    accuracy = np.mean(
        pred_unstable == truth_unstable
    )

    return fpr, fnr, accuracy


def make_table_A1(mu_vl_maps, rho_map):
    rows = []

    for j in range(len(HORIZONS) - 1):
        tau1 = HORIZONS[j]
        tau2 = HORIZONS[j + 1]

        mu1 = mu_vl_maps[j]
        mu2 = mu_vl_maps[j + 1]

        valid = (
            np.isfinite(mu1)
            & np.isfinite(mu2)
        )

        # Numerical growth-rate convergence
        rate_mask = rate_convergence_mask(
            mu1,
            mu2
        )

        p_rate = (
            np.count_nonzero(rate_mask & valid)
            / np.count_nonzero(valid)
            if np.count_nonzero(valid) > 0
            else np.nan
        )

        # Stable/unstable classification convergence
        class_mask = classification_stability_mask(
            mu1,
            mu2
        )

        p_class = (
            np.count_nonzero(class_mask & valid)
            / np.count_nonzero(valid)
            if np.count_nonzero(valid) > 0
            else np.nan
        )

        # FPR/FNR evaluated at the larger horizon tau2
        fpr, fnr, accuracy = classification_metrics(
            mu2,
            rho_map
        )

        rows.append({
            "Horizon pair": rf"{tau1:g} -> {tau2:g}",
            "P_rate (%)": 100.0*p_rate,
            "P_class (%)": 100.0*p_class,
            "FPR (%)": 100.0*fpr,
            "FNR (%)": 100.0*fnr,
        })

    table = pd.DataFrame(rows)

    print(
        "\nTable A1. Quantitative horizon sensitivity"
    )

    print(
        table.to_string(
            index=False,
            formatters={
                "P_rate (%)": "{:.2f}".format,
                "P_class (%)": "{:.2f}".format,
                "FPR (%)": "{:.2f}".format,
                "FNR (%)": "{:.2f}".format,
            }
        )
    )

    table.to_csv(
        "Table_A1_horizon_sensitivity.csv",
        index=False,
        float_format="%.4f"
    )

    latex = table.to_latex(
        index=False,
        escape=False,
        float_format="%.2f",
        caption=(
            "Quantitative sensitivity to the integration horizon. "
            "$P_{\\mathrm{rate}}$ denotes the percentage of parameter-grid "
            "points satisfying the mixed absolute-relative convergence "
            "criterion for the numerical value of $\\mu_{V_L}$, whereas "
            "$P_{\\mathrm{class}}$ denotes the percentage whose binary "
            "growth classification remains unchanged between successive "
            "horizons. FPR and FNR are evaluated at the larger horizon "
            "relative to Floquet stability."
        ),
        label="tab:horizon_sensitivity",
    )

    with open(
        "Table_A1_horizon_sensitivity.tex",
        "w",
        encoding="utf-8"
    ) as f:
        f.write(latex)

    return table


