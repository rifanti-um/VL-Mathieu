def add_floquet_boundary(ax, A, Q, mu_f_map, color):
    """Overlay the Floquet instability boundary."""
    if not SHOW_FLOQUET_BOUNDARY:
        return

    try:
        ax.contour(
            A,
            Q,
            mu_f_map,
            levels=[1.0e-6],
            colors=color,
            linewidths=0.65
        )
    except ValueError:
        pass


def make_figure_A2(a_values, q_values, mu_vl_maps, mu_f_map):
    i80 = horizon_index(80.0)
    i120 = horizon_index(120.0)
    i160 = horizon_index(160.0)

    map80 = mu_vl_maps[i80]
    map120 = mu_vl_maps[i120]
    map160 = mu_vl_maps[i160]

    diff = np.abs(map160 - map120)

    # Same color limits for panels (a)-(c)
