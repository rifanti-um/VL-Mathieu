# ============================================================
# 4. PARAMETER-SPACE COMPUTATION: FINAL 200 x 200
# ============================================================

def _solve_grid_point(task):
    """Worker for one (a,q) grid point."""
    iq, ia, a, q = task

    mu_vl, g_n = trajectory_diagnostics(a, q, HORIZONS)
    mu_f, rho = dominant_floquet_data(a, q)

    return iq, ia, mu_vl, g_n, mu_f, rho


def compute_parameter_space():
    a_values = np.linspace(A_MIN, A_MAX, N_GRID)
    q_values = np.linspace(Q_MIN, Q_MAX, N_GRID)

    shape_3d = (len(HORIZONS), N_GRID, N_GRID)

    mu_vl_maps = np.full(shape_3d, np.nan)
    g_n_maps = np.full(shape_3d, np.nan)
    mu_f_map = np.full((N_GRID, N_GRID), np.nan)
    rho_map = np.full((N_GRID, N_GRID), np.nan)

    tasks = [
        (iq, ia, float(a), float(q))
        for iq, q in enumerate(q_values)
        for ia, a in enumerate(a_values)
    ]

    total = len(tasks)

    print(
        f"\nComputing final parameter-space study: "
        f"{N_GRID} x {N_GRID} = {total} points"
    )

    with ProcessPoolExecutor(max_workers=N_WORKERS) as executor:
        for count, result in enumerate(
            executor.map(
                _solve_grid_point,
                tasks,
                chunksize=8
            ),
            start=1
        ):
            iq, ia, mu_vl, g_n, mu_f, rho = result

            mu_vl_maps[:, iq, ia] = mu_vl
            g_n_maps[:, iq, ia] = g_n
            mu_f_map[iq, ia] = mu_f
            rho_map[iq, ia] = rho

            if count % max(1, total // 20) == 0 or count == total:
                print(
                    f"  progress: {count}/{total} "
                    f"({100.0*count/total:.1f}%)"
                )

    np.savez_compressed(
        CACHE_FILE,
        a_values=a_values,
        q_values=q_values,
        horizons=HORIZONS,
        mu_vl_maps=mu_vl_maps,
        g_n_maps=g_n_maps,
        mu_f_map=mu_f_map,
        rho_map=rho_map,
        n_grid=N_GRID,
        mu_class_tol=MU_CLASS_TOL,
        rho_tol=RHO_TOL,
        eps_rel=EPS_REL,
        eps_abs=EPS_ABS,
    )

    print(f"Saved cache: {CACHE_FILE}")

    return (
        a_values,
        q_values,
        mu_vl_maps,
        g_n_maps,
        mu_f_map,
        rho_map
    )


def load_or_compute_parameter_space():
    if os.path.exists(CACHE_FILE):
        print(f"\nLoading cached 200 x 200 results: {CACHE_FILE}")
        data = np.load(CACHE_FILE)

        cached_n = int(np.asarray(data["n_grid"]).item())

        if cached_n != N_GRID:
            raise ValueError(
                f"Cache contains N_GRID={cached_n}, "
                f"but the script requests N_GRID={N_GRID}."
            )

        return (
            data["a_values"],
            data["q_values"],
            data["mu_vl_maps"],
            data["g_n_maps"],
            data["mu_f_map"],
            data["rho_map"],
        )

    return compute_parameter_space()


def horizon_index(tau):
    idx = np.where(np.isclose(HORIZONS, tau))[0]

    if len(idx) != 1:
        raise ValueError(
            f"Horizon tau={tau} not found in HORIZONS."
        )

    return int(idx[0])


