def print_summary(mu_vl_maps, rho_map):
    print(
        "\n--- Horizon-sensitivity summary ---"
    )

    print(
        "Rate-convergence criterion:\n"
        f"|Delta mu| <= {EPS_ABS:g} "
        f"+ {EPS_REL:g}*max(|mu_1|,|mu_2|)"
    )

    print(
        f"V_L classification threshold: "
        f"mu_VL > {MU_CLASS_TOL:g}"
    )

    print(
        f"Floquet instability threshold: "
        f"rho_max > 1 + {RHO_TOL:g}"
    )

    i120 = horizon_index(120.0)
    i160 = horizon_index(160.0)

    mu120 = mu_vl_maps[i120]
    mu160 = mu_vl_maps[i160]

    diff = np.abs(mu160 - mu120)

    print(
        "\nDifference statistics for tau=120 -> 160:"
    )
    print(
        "  mean   = "
        f"{np.nanmean(diff):.6g}"
    )
    print(
        "  median = "
        f"{np.nanmedian(diff):.6g}"
    )
    print(
        "  95th percentile = "
        f"{np.nanpercentile(diff, 95):.6g}"
    )

    p_class_120_160 = np.mean(
        classification_stability_mask(
            mu120,
            mu160
        )
    )

    p_rate_120_160 = np.mean(
        rate_convergence_mask(
            mu120,
            mu160
        )
    )

    print(
        f"  P_rate(120->160)  = "
        f"{100*p_rate_120_160:.2f}%"
    )

    print(
        f"  P_class(120->160) = "
        f"{100*p_class_120_160:.2f}%"
    )

    for tau in (80.0, 120.0, 160.0):
        idx = horizon_index(tau)

        fpr, fnr, accuracy = classification_metrics(
            mu_vl_maps[idx],
            rho_map
        )

        print(
            f"tau={tau:g}: "
            f"FPR={100*fpr:.2f}%, "
            f"FNR={100*fnr:.2f}%, "
            f"agreement={100*accuracy:.2f}%"
