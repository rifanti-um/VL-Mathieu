# -*- coding: utf-8 -*-
"""
Appendix experiment: integration-horizon sensitivity for the Mathieu equation

    x'' + (a - 2 q cos(2t)) x = 0.

Final configuration
-------------------
- Parameter-space resolution: 200 x 200.
- Main manuscript initial condition: x(0)=1, v(0)=0.
- Solver: DOP853, rtol=1e-10, atol=1e-12.
- Figure A1 uses a genuinely near-Floquet-boundary point:
      (a,q) = (0.5, 0.4738),
  for which mu_F is approximately 8.49e-3 with the settings below.

Outputs
-------
1. Figure_A1_representative_convergence.png/.pdf
   mu_VL(tau), G_N(tau), and dominant Floquet rate mu_F
   for stable, near-boundary, and unstable trajectories.

2. Figure_A2_horizon_sensitivity.png/.pdf
   (a) mu_VL(a,q; tau=80)
   (b) mu_VL(a,q; tau=120)
   (c) mu_VL(a,q; tau=160)
   (d) |mu_VL(a,q;160)-mu_VL(a,q;120)|

3. Table_A1_horizon_sensitivity.csv/.tex
   P_rate, P_class, FPR, and FNR for successive horizon pairs.

Definitions
-----------
P_rate:
    percentage of grid points for which the numerical growth-rate estimate
    satisfies a mixed absolute-relative convergence criterion.

P_class:
    percentage of grid points whose binary stable/unstable classification
    remains unchanged between two successive horizons.

FPR/FNR:
    computed against Floquet stability, at the larger horizon in each pair.

Important
---------
The mixed 5% criterion is a numerical sensitivity criterion, not a universal
theoretical constant. P_class is kept separate because growth-regime
classification may stabilize earlier than the precise numerical value of
mu_VL.
"""

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.integrate import solve_ivp
from concurrent.futures import ProcessPoolExecutor
from multiprocessing import freeze_support


# ============================================================
# 1. GLOBAL SETTINGS
# ============================================================

# Mathieu parameter domain
A_MIN, A_MAX = 0.0, 12.0
Q_MIN, Q_MAX = 0.0, 12.0

# FINAL appendix resolution
N_GRID = 150

# Initial condition
X0 = 1.0
V0 = 0.0
Z0_NORM = np.hypot(X0, V0)

# ODE solver
METHOD = "DOP853"
RTOL = 1.0e-10
ATOL = 1.0e-12
TINY = 1.0e-300

# Period of cos(2t)
T_PERIOD = np.pi

# Horizons used in Table A1
HORIZONS = np.array([80.0, 120.0, 160.0])

# Horizons shown in Figure A2
MAP_HORIZONS = (80.0, 120.0, 160.0)

# Figure A1 representative points
# Near-boundary point chosen from a local Floquet scan around a=0.5.
REPRESENTATIVE_POINTS = {
    "Stable":        (6.0, 1.5),
    "Near-boundary": (0.5, 0.4738),
    "Unstable":      (2.0, 10.0),
}

# Dense horizon sequence for Figure A1
TAU_CURVE = np.arange(10.0, 160.0 + 1e-12, 2.0)

# Floquet ground-truth tolerance
RHO_TOL = 1.0e-7

# V_L finite-time classification:
# unstable/growing iff mu_VL > MU_CLASS_TOL.
# Keep this identical to the classification rule used in the manuscript.
MU_CLASS_TOL = 0.0

# Rate-convergence criterion:
#
# |mu(tau_2)-mu(tau_1)|
# <= EPS_ABS + EPS_REL*max(|mu(tau_1)|, |mu(tau_2)|)
#
# This is a sensitivity criterion only, not a universal constant.
EPS_REL = 0.05
EPS_ABS = 1.0e-3

# Parallelization
N_WORKERS = None

# Versioned cache prevents accidentally reusing an old 81x81 calculation.
CACHE_FILE = f"horizon_sensitivity_cache_v2_N{N_GRID}.npz"

# Figure settings
DPI = 300
CMAP_GROWTH = "jet"
CMAP_DIFFERENCE = "magma"
SHOW_FLOQUET_BOUNDARY = True


# ============================================================
# 2. MATHIEU MODEL AND DIAGNOSTICS
# ============================================================

def mathieu_rhs(t, z, a, q):
    """First-order Mathieu system: x'=v, v'=-(a-2q cos(2t))x."""
    x, v = z
    return np.array([
        v,
        -(a - 2.0*q*np.cos(2.0*t))*x
    ])


def variational_rhs(t, y, a, q):
    """Fundamental matrix equation Phi' = A(t) Phi."""
    Phi = y.reshape(2, 2)

    A = np.array([
        [0.0, 1.0],
        [-(a - 2.0*q*np.cos(2.0*t)), 0.0]
    ])

    return (A @ Phi).ravel()


def dominant_floquet_data(a, q):
    """
    Returns
    -------
    mu_F : float
        Nonnegative dominant Floquet growth rate.
    rho_max : float
        Maximum modulus of the Floquet multipliers.
    """
    sol = solve_ivp(
        variational_rhs,
        (0.0, T_PERIOD),
        np.eye(2).ravel(),
        args=(a, q),
        method=METHOD,
        rtol=RTOL,
        atol=ATOL,
        t_eval=[T_PERIOD],
    )

    if not sol.success:
        raise RuntimeError(
            f"Floquet integration failed at (a,q)=({a},{q}): "
            f"{sol.message}"
        )

    Phi_T = sol.y[:, -1].reshape(2, 2)
    multipliers = np.linalg.eigvals(Phi_T)
    rho_max = float(np.max(np.abs(multipliers)))

    raw_mu = np.log(max(rho_max, TINY)) / T_PERIOD
    mu_F = max(0.0, float(raw_mu))

    return mu_F, rho_max


def trajectory_diagnostics(a, q, horizons):
    """
    Integrate one trajectory once up to max(horizons).

    V_L(tau)
        = |v(tau)-v(0)| / tau

    mu_VL(tau)
        = log(V_L(tau)) / tau

    G_N(tau)
        = (1/tau) log(||z(tau)|| / ||z(0)||)
    """
    horizons = np.asarray(horizons, dtype=float)
    order = np.argsort(horizons)
    hs = horizons[order]

    sol = solve_ivp(
        mathieu_rhs,
        (0.0, float(hs[-1])),
        [X0, V0],
        args=(a, q),
        method=METHOD,
        rtol=RTOL,
        atol=ATOL,
        t_eval=hs,
    )

    if not sol.success:
        raise RuntimeError(
            f"Trajectory integration failed at (a,q)=({a},{q}): "
            f"{sol.message}"
        )

    x = sol.y[0]
    v = sol.y[1]

    VL = np.abs(v - V0) / hs
    mu_VL = np.log(np.maximum(VL, TINY)) / hs

    z_norm = np.hypot(x, v)
    G_N = np.log(np.maximum(z_norm / Z0_NORM, TINY)) / hs

    # Restore original ordering
    inv = np.empty_like(order)
    inv[order] = np.arange(len(order))

    return mu_VL[inv], G_N[inv]


