# ============================================================
# 6. Single global Floquet reference heatmap
# ============================================================

def compute_floquet_map(
    a_min=A_MAP_MIN,
    a_max=A_MAP_MAX,
    q_min=Q_MAP_MIN,
    q_max=Q_MAP_MAX,
    n_a=N_A_MAP,
    n_q=N_Q_MAP
):
    a_vals = np.linspace(a_min, a_max, n_a)
    q_vals = np.linspace(q_min, q_max, n_q)

    mu_F_map = np.empty((n_q, n_a))

    for iq, q in enumerate(q_vals):
        print(
            f"Floquet map: q-row {iq + 1:>3d}/{n_q}",
            end="\r",
            flush=True
        )

        for ia, a in enumerate(a_vals):
            mu_F_map[iq, ia] = floquet_exponent(a, q)

    print(" " * 60, end="\r")

    return a_vals, q_vals, mu_F_map


a_map, q_map, mu_F_map = compute_floquet_map()


# ============================================================
# FIGURE C: one heatmap only
#
# The heatmap is the dominant Floquet growth-rate map.
# Its only purpose here is to show the locations of the
# representative bounded, near-boundary, and exponential points.
# ============================================================

fig, ax = plt.subplots(
    figsize=(7.4, 6.0),
    constrained_layout=True
)

im = ax.pcolormesh(
    a_map,
    q_map,
    mu_F_map,
    shading="auto",
    cmap="jet"
)

markers = ["o", "s", "^"]

for marker, (label, a, q) in zip(markers, selected):
    ax.scatter(
        a,
        q,
        s=80,
        marker=marker,
        facecolors="white",
        edgecolors="black",
        linewidths=1.3,
        label=fr"{label} $(a={a},\,q={q})$",
        zorder=5
    )

ax.set_xlim(A_MAP_MIN, A_MAP_MAX)
ax.set_ylim(Q_MAP_MIN, Q_MAP_MAX)
ax.set_xlabel(r"$a$")
ax.set_ylabel(r"$q$")
ax.set_title("Representative Mathieu parameter points")

cbar = fig.colorbar(
    im,
    ax=ax,
    pad=0.02
)
cbar.set_label(
    r"Dominant Floquet growth rate $\mu_{\mathrm{Floquet}}$"
)

ax.legend(
    loc="upper right",
    frameon=True
)

plt.savefig(
    "Figure_C_representative_points_Floquet_map.png",
    dpi=300,
    bbox_inches="tight"
)
plt.show()


