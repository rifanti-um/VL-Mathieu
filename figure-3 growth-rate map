#FIGURE 3
import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

# ============================================================
# Mathieu equation:
#     x'' + (a - 2 q cos(2t)) x = 0
#
# First-order state:
#     z = (x,v),  v=x'
#
# Raw endpoint quantities:
#     V_L(tau) = |v(tau)-v(0)| / tau
#     A_N(tau) = ||z(tau)|| / ||z(0)||
#
# Finite-time logarithmic growth rates:
#     mu_VL(tau)  = ln(V_L(tau)) / tau
#     mu_A_N(tau) = ln(A_N(tau)) / tau
#
# A single Floquet heatmap is used only as a neutral reference
# to show the locations of the selected parameter points.
# ============================================================

RTOL = 1e-10
ATOL = 1e-12
METHOD = "DOP853"

FLOQUET_RTOL = 1e-11
FLOQUET_ATOL = 1e-13

X0 = 1.0
V0 = 0.0

TAU_MAX_CURVE = 120.0
TAU_MIN_RATE_PLOT = 5.0

N_TIME = 2401
TINY = 1e-300

RATE_YMIN = -0.25
RATE_YMAX = 2.10

# Global parameter domain for the single reference heatmap
A_MAP_MIN = 0.0
A_MAP_MAX = 6.5
Q_MAP_MIN = 0.0
Q_MAP_MAX = 10.5

# Increase to 71 or 81 for a smoother final manuscript figure
N_A_MAP = 61
N_Q_MAP = 61

plt.rcParams.update({
    "font.size": 11,
    "axes.labelsize": 11,
    "axes.titlesize": 11,
    "legend.fontsize": 9,
    "xtick.labelsize": 10,
    "ytick.labelsize": 10,
})


# ============================================================
# 1. Mathieu system
# ============================================================

def mathieu_rhs(t, y, a, q):
    x, v = y
    return [
        v,
        -(a - 2.0 * q * np.cos(2.0 * t)) * x
    ]


# ============================================================
# 2. Trajectory integration
# ============================================================

def integrate_trajectory(a, q, tau_max, x0=X0, v0=V0, n_time=N_TIME):
    t_eval = np.linspace(0.0, tau_max, n_time)

    sol = solve_ivp(
        mathieu_rhs,
        (0.0, tau_max),
        (x0, v0),
        args=(a, q),
        t_eval=t_eval,
        method=METHOD,
        rtol=RTOL,
        atol=ATOL
    )

    if not sol.success:
        raise RuntimeError(sol.message)

    return sol.t, sol.y[0], sol.y[1]


# ============================================================
# 3. Time-dependent observables
# ============================================================

def time_observables(a, q, tau_max=TAU_MAX_CURVE, x0=X0, v0=V0):
    t, x, v = integrate_trajectory(a, q, tau_max, x0, v0)

    tau = t[1:]
    x = x[1:]
    v = v[1:]

    # Raw velocity-variation quantity
    V_L = np.abs(v - v0) / tau

    # Raw endpoint norm amplification
    norm0 = np.hypot(x0, v0)
    norm_t = np.hypot(x, v)
    A_N = norm_t / norm0

    # Finite-time logarithmic growth rates
    mu_VL = np.full_like(tau, np.nan)
    mask_VL = V_L > 0.0
    mu_VL[mask_VL] = np.log(V_L[mask_VL]) / tau[mask_VL]

    mu_A_N = np.log(np.maximum(A_N, TINY)) / tau

    return tau, V_L, A_N, mu_VL, mu_A_N


# ============================================================
# 4. Representative parameter points
# ============================================================

selected = [
    ("Bounded",       6.0,  1.5),
    ("Near-boundary", 0.5,  0.4738),
    ("Exponential",   2.0, 10.0),
]


# ============================================================
# 5. Floquet exponent
#
# The coefficient period is T = pi.
# ============================================================

def floquet_exponent(a, q):
    T = np.pi

    def fundamental_rhs(t, phi_flat):
        Phi = phi_flat.reshape(2, 2)

        c = a - 2.0 * q * np.cos(2.0 * t)

        A = np.array([
            [0.0, 1.0],
            [-c,  0.0]
        ])

        return (A @ Phi).ravel()

    Phi0 = np.eye(2).ravel()

    sol = solve_ivp(
        fundamental_rhs,
        (0.0, T),
        Phi0,
        method=METHOD,
        rtol=FLOQUET_RTOL,
        atol=FLOQUET_ATOL
    )

    if not sol.success:
        raise RuntimeError(sol.message)

    Phi_T = sol.y[:, -1].reshape(2, 2)
    multipliers = np.linalg.eigvals(Phi_T)

    rho_max = np.max(np.abs(multipliers))
    mu_F = np.log(rho_max) / T

    if abs(mu_F) < 1e-9:
        mu_F = 0.0

    return max(mu_F, 0.0)


# ============================================================
# FIGURE A: raw endpoint quantities
# ============================================================

fig, axs = plt.subplots(
    1, 2,
    figsize=(12.5, 4.8),
    constrained_layout=True
)

for label, a, q in selected:
    tau, V_L, A_N, mu_VL, mu_A_N = time_observables(a, q)

    axs[0].semilogy(
        tau,
        np.maximum(V_L, TINY),
        linewidth=1.6,
        label=fr"{label} $(a={a},\,q={q})$"
    )

    axs[1].semilogy(
        tau,
        np.maximum(A_N, TINY),
        linewidth=1.6,
        label=fr"{label} $(a={a},\,q={q})$"
    )

axs[0].set_title(r"$V_L(\tau)$")
axs[0].set_xlabel(r"Integration time $\tau$")
axs[0].set_ylabel(r"$V_L(\tau)$")
axs[0].grid(True, linestyle=":", alpha=0.7)
axs[0].legend(loc="best")

axs[1].set_title(r"Endpoint norm amplification $A_N(\tau)$")
axs[1].set_xlabel(r"Integration time $\tau$")
axs[1].set_ylabel(
    r"$A_N(\tau)=\|\mathbf{z}(\tau)\|/\|\mathbf{z}(0)\|$"
)
axs[1].grid(True, linestyle=":", alpha=0.7)
axs[1].legend(loc="best")

plt.savefig(
    "Figure_A_selected_raw_VL_and_AN.png",
